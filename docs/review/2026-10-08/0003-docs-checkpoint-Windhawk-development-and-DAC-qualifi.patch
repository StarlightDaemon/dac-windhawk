+4..5 | ForEach-Object { ./windhawk/tools/run-check.ps1 -Name "saver-x86-$_" -TestArguments @('--probe',"$_",'0','x86') }
+./windhawk/tools/run-check.ps1 -Name missing -TestArguments @('--probe','1','0','missing')
