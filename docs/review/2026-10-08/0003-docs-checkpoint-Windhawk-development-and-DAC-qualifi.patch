+# Run on the affected machine as the same Windows user running Windhawk.
+# Reads configuration metadata and backup bytes; prints a redacted JSON report.
+# Does not save preferences, change startup, contact a server, or probe hardware.
+param([string]$SettingsDirectory=(Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'DAC-Windhawk'))
+$ErrorActionPreference='Stop'
+function Read-SettingsEvidence([string]$Name) {
+    $row=[ordered]@{name=$Name;state='unknown';length=$null;readOnly=$null;schema=$null;errorCode=$null}
+    $bytes=$null
+    try {
+        $path=Join-Path $SettingsDirectory $Name
+        $attributes=[IO.File]::GetAttributes($path)
+        $row.readOnly=($attributes -band [IO.FileAttributes]::ReadOnly) -ne 0
+        $row.length=([IO.FileInfo]::new($path)).Length
+        if($row.length -gt 262144){$row.state='too-large'}
+        else {
+            $bytes=[IO.File]::ReadAllBytes($path)
+            $text=[Text.Encoding]::UTF8.GetString($bytes).TrimStart([char]0xfeff)
+            $match=[regex]::Match($text,'(?m)^\s*version\s*=\s*(\d+)\s*$')
+            if($match.Success){$row.schema=$match.Groups[1].Value}
+            $row.state='readable'
+        }
+    } catch {
+        $cause=$_.Exception;while($cause.InnerException){$cause=$cause.InnerException}
+        $row.errorCode=$cause.HResult -band 0xffff
+        $row.state=if($row.errorCode -in @(2,3)){'missing'}else{'read-error'}
+    }
+    [pscustomobject]@{report=$row;bytes=$bytes}
+}
+$directory=[ordered]@{state='unknown';errorCode=$null}
+try {
+    $attrs=[IO.File]::GetAttributes($SettingsDirectory)
+    $directory.state=if(($attrs -band [IO.FileAttributes]::Directory) -ne 0){'present'}else{'not-a-directory'}
+} catch {
+    $cause=$_.Exception;while($cause.InnerException){$cause=$cause.InnerException}
+    $directory.errorCode=$cause.HResult -band 0xffff
+    $directory.state=if($directory.errorCode -in @(2,3)){'missing'}else{'read-error'}
+}
+$legacy=@(foreach($view in @([Microsoft.Win32.RegistryView]::Registry32,[Microsoft.Win32.RegistryView]::Registry64)) {
+    $base=$null;$key=$null;$row=[ordered]@{view=$view.ToString();present=$null;errorCode=$null}
+    try {
+        $base=[Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::CurrentUser,$view)
+        $key=$base.OpenSubKey('Software\Microsoft\Windows\CurrentVersion\Run',$false)
+        $row.present=$null -ne $key -and @($key.GetValueNames()) -contains 'OLED Aegis'
+    } catch {
+        $cause=$_.Exception;while($cause.InnerException){$cause=$cause.InnerException}
+        $row.errorCode=$cause.HResult -band 0xffff
+    } finally {if($key){$key.Dispose()};if($base){$base.Dispose()}}
+    $row
+})
+$current=Read-SettingsEvidence 'settings-v1.ini'
+$files=@($current.report)
+foreach($name in @('settings-v1.ini.v1-backup','settings-v1.ini.v2-backup')) {
+    $backup=Read-SettingsEvidence $name
+    $backup.report.matchesCurrent=$null
+    if($null -ne $current.bytes -and $null -ne $backup.bytes){
+        $backup.report.matchesCurrent=([Convert]::ToBase64String($current.bytes) -ceq [Convert]::ToBase64String($backup.bytes))
+    }
+    $files+=,$backup.report
+}
+[ordered]@{
+    reportVersion=1
+    collectedUtc=[DateTime]::UtcNow.ToString('o')
+    windowsVersion=[Environment]::OSVersion.Version.ToString()
+    os64Bit=[Environment]::Is64BitOperatingSystem
+    collector64Bit=[Environment]::Is64BitProcess
+    settingsDirectory=$directory
+    legacyStartup=$legacy
+    files=$files
+    limits='Reads this user account only. Does not validate full configuration syntax or prove write access. No configuration contents, paths, user names or recovery tickets are included.'
+} | ConvertTo-Json -Depth 6
