+"""Reproducible source-similarity evidence; no authorship/license inference.
+
+Python standard library only. Reads git baseline + working files, writes JSON.
+Exact tokens preserve identifiers/literals; shape tokens erase their spelling.
+All maximal contiguous matches >= k are included; coverage counts a token once.
+"""
+import argparse
+import bisect
+import collections
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[3]
+BASE = "edaef74233b75708ea4354e3e15793f195567e34"
+PATTERN = re.compile(
+    r'(?P<comment>//[^\n]*|/\*.*?\*/)'
+    r'|(?P<string>(?:u8|[LuU])?"(?:\\.|[^"\\])*"|(?:[LuU])?\'(?:\\.|[^\'\\])*\')'
+    r'|(?P<identifier>[A-Za-z_][A-Za-z_0-9]*)'
+    r'|(?P<number>(?:0[xX][0-9A-Fa-f]+|\d+(?:\.\d*)?)(?:[eEpP][+-]?\d+)?[uUlLfF]*)'
+    r'|(?P<symbol>::|->|&&|\|\||==|!=|<=|>=|<<|>>|\+\+|--|\+=|-=|\*=|/=|&=|\|=|\S)',
+    re.S,
+)
+KEYWORDS = set("alignas alignof asm auto bool break case catch char char8_t char16_t char32_t class const constexpr consteval constinit continue default delete do double else enum explicit extern false float for friend goto if inline int long mutable namespace new noexcept nullptr operator private protected public register reinterpret_cast return short signed sizeof static static_cast struct switch template this thread_local throw true try typedef typeid typename union unsigned using virtual void volatile wchar_t while dynamic_cast const_cast".split())
+
+def git(*args):
+    return subprocess.check_output(["git", "-C", str(ROOT), *args])
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+def tokens(text, exclude_fujin=False):
+    # No C++ raw literals in these inputs; fail rather than silently misparse.
+    if re.search(r'\b(?:u8|[LuU])?R"', text):
+        raise ValueError("Raw C++ literal needs lexer support")
+    starts = [0] + [m.end() for m in re.finditer("\n", text)]
+    result = []
+    block = re.search(r'// BEGIN GENERATED FUJIN.*?// END GENERATED FUJIN', text, re.S) if exclude_fujin else None
+    gap = False
+    for match in PATTERN.finditer(text):
+        if block and block.start() <= match.start() < block.end():
+            if not gap:
+                result.append(("<FUJIN_BOUNDARY>", "boundary", bisect.bisect_right(starts, match.start())))
+                gap = True
+            continue
+        if match.lastgroup != "comment":
+            result.append((match.group(), match.lastgroup, bisect.bisect_right(starts, match.start())))
+    return result
+
+def values(items, shape=False):
+    return ["<ID>" if shape and kind == "identifier" and value not in KEYWORDS
+            else "<LITERAL>" if shape and kind in ("number", "string") else value
+            for value, kind, _ in items]
+
+def without_directives(items, text, side):
+    # Preserve boundaries rather than invent matches across removed directives.
+    lines = {i for i,line in enumerate(text.splitlines(),1) if line.lstrip().startswith('#')}
+    return [(f"<{side}_DIRECTIVE_{line}>", "boundary", line) if line in lines else item
+            for item in items for _,_,line in [item]]
+
+def blocks(a, b, minimum):
+    index = collections.defaultdict(list)
+    for i in range(len(a) - minimum + 1):
+        index[tuple(a[i:i + minimum])].append(i)
+    result = []
+    for j in range(len(b) - minimum + 1):
+        for i in index.get(tuple(b[j:j + minimum]), ()):
+            if i and j and a[i - 1] == b[j - 1]:
+                continue  # same diagonal's maximal match already starts earlier
+            n = minimum
+            while i + n < len(a) and j + n < len(b) and a[i + n] == b[j + n]:
+                n += 1
+            result.append((i, j, n))
+    return sorted(result, key=lambda x: (-x[2], x[1], x[0]))
+
+def compare(a, b, minimum, shape):
+    matches = blocks(values(a, shape), values(b, shape), minimum)
+    old, new = set(), set()
+    for i, j, n in matches:
+        old.update(range(i, i + n)); new.update(range(j, j + n))
+    old_count = sum(t[1] != "boundary" for t in a)
+    new_count = sum(t[1] != "boundary" for t in b)
+    return dict(minimum_tokens=minimum, mode="shape" if shape else "exact",
+                baseline_tokens=old_count, target_tokens=new_count,
+                baseline_covered=len(old), target_covered=len(new),
+                baseline_percent=round(100 * len(old) / old_count, 4),
+                target_percent=round(100 * len(new) / new_count, 4),
+                maximal_match_count=len(matches), longest_tokens=max((n for _, _, n in matches), default=0),
+                matches=[dict(baseline_start=a[i][2], baseline_end=a[i+n-1][2],
+                              target_start=b[j][2], target_end=b[j+n-1][2], tokens=n)
+                         for i, j, n in matches])
+
+def line_overlap(a, b, minimum=30):
+    # Whole literal lines, trimmed only; exclude braces/empty and tiny boilerplate.
+    aa = {line.strip() for line in a.splitlines() if len(line.strip()) >= minimum}
+    bb = [(i, line.strip()) for i, line in enumerate(b.splitlines(), 1) if len(line.strip()) >= minimum]
+    hits = [(i, line) for i, line in bb if line in aa]
+    return dict(minimum_characters=minimum, target_eligible_lines=len(bb), target_matched_lines=len(hits),
+                target_percent=round(100 * len(hits) / len(bb), 4), matches=hits)
+
+def self_test():
+    # Naive exhaustive reference verifies maximal-match and union accounting.
+    import random
+    rng = random.Random(482)
+    for _ in range(100):
+        a = [rng.randrange(4) for _ in range(25)]
+        b = [rng.randrange(4) for _ in range(25)]
+        expected = []
+        for i in range(len(a)):
+            for j in range(len(b)):
+                if i and j and a[i-1] == b[j-1]: continue
+                n = 0
+                while i+n < len(a) and j+n < len(b) and a[i+n] == b[j+n]: n += 1
+                if n >= 3: expected.append((i,j,n))
+        assert set(blocks(a,b,3)) == set(expected)
+    a = tokens('int work(int value) { /* ignore */ return value + 23; }')
+    b = tokens('int work ( int value ) {\nreturn value + 23; } // ignore')
+    c = tokens('int other(int data) { return data + 91; }')
+    assert values(a) == values(b) and values(a) != values(c)
+    assert values(a, True) == values(c, True)
+    assert compare(a,b,5,False)["target_percent"] == 100
+    assert not blocks(list(range(10)),list(range(20,30)),3)
+    assert tokens('const char* a="//not a comment";')[5][1] == "string"
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", default=str(ROOT / "build/analysis/source-comparison.json"))
+    args = parser.parse_args()
+    self_test()
+    baseline_bytes = git("show", f"{BASE}:src/oled_aegis.c")
+    baseline = baseline_bytes.decode("utf-8-sig")
+    inherited = (ROOT / "src/oled_aegis.c").read_bytes()
+    old = tokens(baseline)
+    result = dict(schema=1, baseline_commit=BASE, baseline_path="src/oled_aegis.c",
+                  baseline_sha256=digest(baseline_bytes), inherited_worktree_sha256=digest(inherited),
+                  inherited_worktree_equal_after_newline_normalization=(baseline.replace("\r\n","\n") == inherited.decode("utf-8-sig").replace("\r\n","\n")),
+                  script_sha256=digest(Path(__file__).read_bytes()),
+                  baseline_lines=len(baseline.splitlines()), targets={})
+    for name in ("windhawk/mods/dac-windhawk.wh.cpp", "windhawk/prototype/oled-aegis-prototype.wh.cpp", "windhawk/tests/policy.cpp", "windhawk/tests/platform.cpp", "windhawk/tools/harness.cpp"):
+        data = (ROOT / name).read_bytes(); text = data.decode("utf-8-sig")
+        target = tokens(text)
+        entry = dict(sha256=digest(data), lines=len(text.splitlines()), tokens=len(target),
+                     whole_line_overlap=line_overlap(baseline,text),
+                     nonblank_line_overlap=line_overlap(baseline,text,1), metrics=[])
+        for shape in (False, True):
+            for minimum in (20,50,100):
+                metric=compare(old,target,minimum,shape)
+                metric["target_scope"]="full"; entry["metrics"].append(metric)
+        if name.startswith("windhawk/mods/"):
+            non_fujin=tokens(text,True)
+            entry["non_fujin_tokens"]=sum(t[1]!="boundary" for t in non_fujin)
+            for shape in (False,True):
+                for minimum in (20,50,100):
+                    metric=compare(old,non_fujin,minimum,shape)
+                    metric["target_scope"]="excluding_fujin";entry["metrics"].append(metric)
+            old_body=without_directives(old,baseline,"OLD")
+            new_body=without_directives(non_fujin,text,"NEW")
+            for shape in (False,True):
+                for minimum in (20,50,100):
+                    metric=compare(old_body,new_body,minimum,shape)
+                    metric["target_scope"]="excluding_fujin_and_directives";entry["metrics"].append(metric)
+        result["targets"][name]=entry
+    out=Path(args.out);out.parent.mkdir(parents=True,exist_ok=True)
+    out.write_text(json.dumps(result,indent=2,ensure_ascii=False)+"\n",encoding="utf-8")
+    print(f"PASS analytical self-tests; evidence: {out}")
+    for name,entry in result["targets"].items():
+        print(name,entry["lines"],"lines",entry["tokens"],"tokens")
+        for m in entry["metrics"]:
+            print(m["target_scope"],m["mode"],m["minimum_tokens"],m["target_covered"],m["target_percent"],"longest",m["longest_tokens"])
+
+if __name__=="__main__": main()
